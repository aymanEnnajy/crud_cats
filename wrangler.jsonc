{
    "name": "proj-full-api",
    "main": "worker.js",
    "compatibility_date": "2025-12-18",
    "vars": {
        "ENV": "production"
    },
    "assets": {
        "directory": "./Public"
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "proj_full_db",
            "database_id": "REPLACE_WITH_YOUR_DB_ID"
        }
    ]
}